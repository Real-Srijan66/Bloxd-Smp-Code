    }
};
//tick handles joins for now
tick = () => {
    while (!api.isNearInterrupt()) {
        for (let p in handleJoin) {
            if (!api.checkValid(p)) {
                delete handleJoin[p];
                continue;
            }
            setUpPlayer(p);
            delete handleJoin[p];
        }
        break;
    }
};
onPlayerChat = (p, m, c) => {
    if (m[0] == "!") {
        let args = m.split(" ");
        let cmd = args[0].toLowerCase();
        if (cmd == "!help") return sendHelpMsg(p);
        else if (cmd == "!rtp") return rtp(p);
        else if (cmd == "!shop") {
            if (cache.length == 0) {
                cache.push({ str: "Shop", style: { color: "cyan", fontSize: "30px" } });
                for (let item in shop) {
                    let itemObj = shop[item];
                    cache.push({ str: `\n${itemObj.apiName}: (cost: ${itemObj.cost}, sell: ${itemObj.sell})`, style: { color: "orange" } });
                }
            }
            api.sendMessage(p, cache);
        }
        else if (cmd == "!sell") {
            if (args.length < 3) return api.sendMessage(p, "Syntax !sell amount item", { color: "yellow" }), false;
            sellItem(p, args.slice(2, args.length).join(" ").toLowerCase(), args[1]);
            return false;
        } else if (cmd == "!buy") {
            if (args.length < 3) return api.sendMessage(p, "Syntax !buy amount item", { color: "yellow" }), false;
            buyItem(p, args.slice(2, args.length).join(" ").toLowerCase(), args[1]);
            return false;
        }
        else if (cmd == "!pay") {
            if (args.length < 3) return api.sendMessage(p, "Syntax !pay <partial name> amount", { color: "yellow" }), false;
            let id = checkPartialName(p, args[1]);
            if (id) payPlayer(p, args[2], id);
            return false;
        } else if (cmd == "!whisper" || cmd == "!w") {
            if (args.length < 3) return sendErrorMsg(p, " Syntax !whisper <partial name> msg | !w <partial name> msg."), false;
            let id = checkPartialName(p, args[1]);
            if (id) whisperToPlayer(p, args.slice(2, args.length).join(" "), id);
            return false;
        } else if (cmd == "!bounty" || cmd == "!b") {
            if (args.length < 3) return sendErrorMsg(p, " Syntax !bounty <partial name> amount | !b <partial name> amount."), false;
            let id = checkPartialName(p, args[1]);
            if (id) bountyPlayer(p, args[2], id);
            return false;
        } else if (cmd == "!bet") {
            if (args.length < 2) return sendErrorMsg(p, " Syntax !bet amount."), false;
            casino(p, args[1]);
            return false;
        } else if (cmd == "!hunt" || cmd == "!h") {
            if (args.length < 3) return sendErrorMsg(p, " Syntax !hunt <partial name> | !h <partial name>."), false;
            let id = checkPartialName(p, args[1]);
            if (id) huntPlayer(p, id);
            return false;
        }
        else {
            api.sendMessage(p, "Invalid Command! Sending help Msg for you.", { color: "red" });
            return sendHelpMsg(p);
        }
    }
};
