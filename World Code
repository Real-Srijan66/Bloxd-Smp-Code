Make new item in shop by adding "itemNameInLowerCase":{cost:positiveNumber,sell:positiveNumber,apiName:"actualItemNameWithCasing"},
*/
const enableMace = true
const enableTotemOfUndying = true
//Sample has been added for you. Note: Do not make sell price more than buy price else all the players have infinite money.
const shop = {
    "maple log": { apiName: "Maple Log", cost: 4, sell: 2 },
    "coal": { sell: 15, cost: 35, apiName: "Coal" },
    "iron bar": { cost: 40, sell: 30, apiName: "Iron Bar" },
    "gold bar": { cost: 65, sell: 50, apiName: "Gold Bar" },
    "diamond": { sell: 90, cost: 100, apiName: "Diamond" },
    "moonstone": { cost: 150, sell: 120, apiName: "Moonstone" },
};
/** CONFIGURATION end */
const lobbyName = api.getLobbyName()//Get lobby name so that people don't have to update this variable when lobby name changes.
const validStats = ["money", "kills", "deaths", "playtime", "bounty"];//Valid stats
const safeInteger = Number.MAX_SAFE_INTEGER;//Prevent numbers from overflowing.
const isNum = (s) => /^\d+$/.test(s);//Test to show if a nuber is a valid non-negative number.
const getRandomInt = (min, max) => {//Gets a random number from min to max
    min = Math.ceil(min);
    max = Math.floor(max);
    return Math.floor(Math.random() * (max - min + 1)) + min;
};
//Mace logic
function handleMace(k, v, d, i) {
    if (!enableMace) return true;
    
    if (i.includes("Mace")) {
        d = Math.round(d * 1.5);
        if (getRandomInt(1, 10) === 5) {
            d = Math.floor(d * 1.75);
            api.sendMessage(k, [{ icon: "swords", style: { color: "red" } }, { str: "Critical Damage!", style: { color: "orange" } }]);
        }
        api.applyHealthChange(v, -d, k);
        api.setVelocity(k, 0, Math.min(1000, d / 1.25), 0);
        return "preventDamage";
    }
    return true;
}
